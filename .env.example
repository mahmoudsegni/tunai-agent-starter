# Copy this file to .env and fill in your key. .env is git-ignored: never commit it.

# Create a key at https://console.tunai.tn (API keys). It starts with sk-tunai-
TUNAI_API_KEY=

# Optional. These are the defaults.
TUNAI_BASE_URL=https://api.tunai.tn/v1
TUNAI_CHAT_MODEL=gpt-5.4-mini
TUNAI_EMBEDDING_MODEL=text-embedding-3-small
# Leave empty to skip reranking and rank by embedding similarity alone.
TUNAI_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
TUNAI_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
